# Copy to .env; never commit real credentials.
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.siliconflow.cn/v1
# CLI --model takes precedence.
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# Optional retrieval cache; cache-only mode returns a typed error on cache misses.
SEARCH_CACHE_DIR=.cache/wikipedia
SEARCH_CACHE_ONLY=0
